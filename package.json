{
  "name": "@wyre-technology/node-salesbuildr",
  "version": "1.0.1",
  "description": "Comprehensive, fully-typed Node.js/TypeScript library for the SalesBuildr public API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "salesbuildr",
    "msp",
    "quoting",
    "proposals",
    "crm",
    "api",
    "typescript",
    "it-sales",
    "opportunities"
  ],
  "author": "Aaron Sachs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyre-technology/node-salesbuildr.git"
  },
  "bugs": {
    "url": "https://github.com/wyre-technology/node-salesbuildr/issues"
  },
  "homepage": "https://github.com/wyre-technology/node-salesbuildr#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@types/node": "^25.9.3",
    "semantic-release": "^25.0.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
